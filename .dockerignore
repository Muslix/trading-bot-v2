# .dockerignore for Crypto Trading Bot
# Git files
.git
.gitignore
.github/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Environment files (keep .env.template)
.env
.env.local
.env.production
.env.test
.env.*.local

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Logs
logs/
*.log

# Test files (but keep requirements-dev.txt)
tests/
htmlcov/
.pytest_cache/
.coverage
*.coverage

# Database files (will be mounted as volume)
*.db
*.sqlite3

# Backup files
*.backup
*.bak
*_backup.py

# Documentation (keep README.md)
docs/
*.backup
*.bak

# CI/CD files (keep essential scripts)
.github/
Makefile.backup

# Deployment scripts (keep scripts/ folder)
deployment/

# Temporary files
tmp/
temp/
