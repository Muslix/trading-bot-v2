# =============================================================================
# CRYPTO TRADING BOT v2.0 - ENVIRONMENT CONFIGURATION
# =============================================================================

# =============================================================================
# TELEGRAM CONFIGURATION
# =============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID by messaging your bot and visiting:
# https://api.telegram.org/bot<your_token>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_PATH=crypto_trading_bot.db

# =============================================================================
# WEB API CONFIGURATION
# =============================================================================
WEB_HOST=0.0.0.0
WEB_PORT=5000

# =============================================================================
# TRADING & MONITORING SETTINGS
# =============================================================================
# Minimum profit percentage for arbitrage alerts
ARBITRAGE_THRESHOLD=1.5

# Minimum Sharpe ratio change to trigger performance alert
SHARPE_CHANGE_THRESHOLD=0.5

# Cooldown period (minutes) between similar alerts to prevent spam
ALERT_COOLDOWN_MINUTES=10

# =============================================================================
# MONITORING INTERVALS (in seconds)
# =============================================================================
# How often to check for arbitrage opportunities
ARBITRAGE_CHECK_INTERVAL=30

# How often to analyze portfolio performance
PERFORMANCE_CHECK_INTERVAL=600

# How often to update live prices
PRICE_UPDATE_INTERVAL=30

# =============================================================================
# CRYPTO WATCHLIST
# =============================================================================
# Number of top cryptocurrencies to analyze for performance
ANALYSIS_CRYPTO_COUNT=100

# Specific symbols to monitor for arbitrage (comma-separated)
WATCHLIST_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,ADA/USDT,DOT/USDT,SOL/USDT,MATIC/USDT,AVAX/USDT

# Exchanges to compare for arbitrage opportunities
EXCHANGES=binance,coinbase,kraken

# =============================================================================
# SECURITY & ENVIRONMENT
# =============================================================================
# Environment type (development, staging, production)
ENVIRONMENT=production

# Secret key for web sessions (generate a random string)
SECRET_KEY=your_secret_key_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log file path
LOG_FILE=bot.log

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Enable/disable parallel processing for portfolio analysis
ENABLE_PARALLEL_PROCESSING=true

# Number of concurrent threads for API calls
MAX_CONCURRENT_REQUESTS=10

# Request timeout in seconds
REQUEST_TIMEOUT=30

# =============================================================================
# OPTIONAL: MONITORING & OBSERVABILITY
# =============================================================================
# Prometheus metrics endpoint
METRICS_ENABLED=true
METRICS_PORT=8000

# Health check endpoint
HEALTH_CHECK_ENABLED=true

# =============================================================================
# OPTIONAL: SLACK NOTIFICATIONS (for CI/CD)
# =============================================================================
# SLACK_WEBHOOK_URL=your_slack_webhook_url_here
# SLACK_CHANNEL=#crypto-bot-alerts

# =============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS
# =============================================================================
# EMAIL_ENABLED=false
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USERNAME=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# NOTIFICATION_EMAIL=alerts@yourcompany.com
