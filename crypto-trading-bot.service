[Unit]
Description=Crypto Trading Bot 24/7 Monitor
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=muslix
WorkingDirectory=/home/muslix/trading_bot_v2
Environment=PYTHONPATH=/home/muslix/trading_bot_v2
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/muslix/trading_bot_v2/src/crypto_monitor_24_7.py
Restart=always
RestartSec=10
StandardOutput=append:/home/muslix/trading_bot_v2/logs/systemd.log
StandardError=append:/home/muslix/trading_bot_v2/logs/systemd_error.log

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/home/muslix/trading_bot_v2

[Install]
WantedBy=multi-user.target
