# Crypto Trading Bot 24/7 - Environment Variables Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram Chat ID (message your bot first to get this)
TELEGRAM_CHAT_ID=your_chat_id_here

# =============================================================================
# DATABASE CONFIGURATION  
# =============================================================================
# SQLite database file path
DATABASE_PATH=crypto_trading_bot.db

# =============================================================================
# WEB API CONFIGURATION
# =============================================================================
# Web dashboard host (0.0.0.0 for external access, 127.0.0.1 for local only)
WEB_HOST=127.0.0.1

# Web dashboard port
WEB_PORT=5000

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# How often to check for arbitrage opportunities (in seconds)
ARBITRAGE_CHECK_INTERVAL=30

# How often to run performance analysis (in seconds)  
PERFORMANCE_CHECK_INTERVAL=600

# Hour for daily summary (24-hour format)
DAILY_SUMMARY_HOUR=8

# Number of cryptocurrencies to analyze for performance
ANALYSIS_CRYPTO_COUNT=50

# =============================================================================
# ALERT CONFIGURATION
# =============================================================================
# Minimum arbitrage profit percentage to trigger alert
ARBITRAGE_THRESHOLD=2.0

# Minimum Sharpe ratio change to trigger alert
SHARPE_CHANGE_THRESHOLD=0.5

# Cooldown between similar alerts (in minutes)
ALERT_COOLDOWN_MINUTES=5

# =============================================================================
# WATCHLIST CONFIGURATION
# =============================================================================
# Comma-separated list of cryptocurrency pairs to monitor
WATCHLIST_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,ADA/USDT,DOT/USDT

# =============================================================================
# EXCHANGES CONFIGURATION
# =============================================================================
# Comma-separated list of exchanges to monitor
EXCHANGES=binance,coinbase,kraken

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE=

# =============================================================================
# DEVELOPMENT/DEBUG SETTINGS
# =============================================================================
# Enable debug mode (true/false)
DEBUG_MODE=false

# Enable test mode (uses demo data instead of real APIs)
TEST_MODE=false