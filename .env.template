# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# CoinGecko API (free tier - no key needed, but can be added if premium)
COINGECKO_API_KEY=your_coingecko_api_key_here_if_premium

# Exchange API Keys (if using live trading)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Database Configuration
DATABASE_URL=sqlite:///crypto_trading_bot.db

# Logging Configuration
LOG_LEVEL=INFO

# Application Configuration
DEBUG_MODE=false
ENVIRONMENT=development
