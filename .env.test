# Test Production Environment Configuration for Crypto Trading Bot

# Environment
ENVIRONMENT=test_production

# Telegram Configuration (Demo mode)
TELEGRAM_BOT_TOKEN=demo_token
TELEGRAM_CHAT_ID=123456789

# Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=30

# Monitoring Configuration (faster for testing)
ARBITRAGE_CHECK_INTERVAL=10
PERFORMANCE_CHECK_INTERVAL=60
DAILY_SUMMARY_HOUR=8

# Trading Configuration (limited for testing)
WATCHLIST_SYMBOLS=BTC,ETH,BNB
ANALYSIS_CRYPTO_COUNT=10
EXCHANGES=binance,coinbase

# Database Configuration
DATABASE_URL=sqlite:///test_trading_bot.db
DATABASE_BACKUP_INTERVAL=3600

# Security Configuration
API_RATE_LIMIT=100
MAX_POSITION_SIZE=100
ENABLE_PAPER_TRADING=true

# Performance Configuration
MAX_CONCURRENT_REQUESTS=5
REQUEST_TIMEOUT=30
CACHE_TTL=300

# Alert Configuration
ARBITRAGE_THRESHOLD=1.5
SHARPE_CHANGE_THRESHOLD=0.5
ALERT_COOLDOWN_MINUTES=15

# Production Debugging
PRODUCTION_LOGGING=true
DEBUG_CALCULATIONS=true
LOG_DATA_SOURCES=true
LOG_PRICE_DATA=true
LOG_METRICS_CALCULATION=true